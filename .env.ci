# CI-only environment. No secrets: APP_KEY is generated in the workflow,
# JWT keys are generated by `php artisan opescare:jwt-keys`.
APP_NAME="OpesCare Finder"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=opescare_test
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

OPESCARE_DEMO_MODE=false
