/node_modules
/public/build
/public/hot
/public/storage
# Uploaded files (clinician photos, and anything else written through
# the private disk). Production is a git checkout, so without this a
# deploy could commit a real person's uploads into the repository.
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
/.nova
/.zed

# Regenerated at runtime / deploy — never committed
/bootstrap/cache/*.php
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*.php
/storage/framework/testing/*
/storage/logs/*.log
/storage/app/livewire-tmp/*
