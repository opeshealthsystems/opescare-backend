/node_modules
/public/build
/public/hot
/public/storage
# Uploaded files (clinician photos, and anything else written through
# the private disk). Production is a git checkout, so without this a
# deploy could commit a real person's uploads into the repository.
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
/.nova
/.zed

# Regenerated at runtime / deploy — never committed
/bootstrap/cache/*.php
/storage/framework/cache/data/*
/storage/framework/sessions/*
# Compiled Blade. The old `views/*.php` pattern matched only the top level, so
# the per-worker `views/test_N/` directories a parallel `artisan test` creates
# were tracked instead — 267 compiled files, rewritten by every run, and
# deleted wholesale the next time anyone ran `view:cache`.
/storage/framework/views/**
/storage/framework/testing/*
/storage/logs/*.log
/storage/app/livewire-tmp/*
